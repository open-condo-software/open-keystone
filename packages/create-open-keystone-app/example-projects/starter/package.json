{
  "name": "@open-keystone/example-projects-starter",
  "description": "An example OpenKeystone project with a User list and Authentication.",
  "private": true,
  "version": "0.0.0-development",
  "author": "The OpenKeystone Development Team",
  "repository": "https://github.com/open-condo-software/open-keystone/tree/main/packages/create-open-keystone-app/example-projects/starter",
  "homepage": "https://github.com/open-condo-software/open-keystone",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development DISABLE_LOGGING=true keystone dev",
    "build": "cross-env NODE_ENV=production keystone build",
    "start": "cross-env NODE_ENV=production keystone start",
    "create-tables": "cross-env CREATE_TABLES=true keystone create-tables"
  },
  "dependencies": {
    "@open-keystone/adapter-mongoose": "workspace:^",
    "@open-keystone/app-admin-ui": "workspace:^",
    "@open-keystone/app-graphql": "workspace:^",
    "@open-keystone/auth-password": "workspace:^",
    "@open-keystone/fields": "workspace:^",
    "@open-keystone/keystone": "workspace:^",
    "cross-env": "^7.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
